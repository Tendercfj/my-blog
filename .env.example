# Next.js runtime: use the Neon pooled connection string (`-pooler` hostname).
DATABASE_URL=postgresql://<runtime-user>:<password>@<project>-pooler.<region>.aws.neon.tech/<database>?sslmode=require

# Migration/bootstrap/recovery only: use the direct Neon connection string.
DATABASE_URL_UNPOOLED=postgresql://<migration-user>:<password>@<project>.<region>.aws.neon.tech/<database>?sslmode=require

# Public origin used for write-request Origin validation and bootstrap site URL.
APP_ORIGIN=https://localhost:3000

# Generate an independent random secret with at least 32 characters.
AUTH_RATE_LIMIT_PEPPER=<replace-with-random-secret>

# Cloudflare R2 S3 API credentials (server-only; never use NEXT_PUBLIC_*).
CLOUDFLARE_ACCOUNT_ID=<cloudflare-account-id>
CLOUDFLARE_R2_ACCESS_KEY_ID=<r2-access-key-id>
CLOUDFLARE_R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
CLOUDFLARE_R2_BUCKET_NAME=<r2-bucket-name>
